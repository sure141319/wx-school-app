<view class="page-shell-plain publish-shell">
  <view class="publish-intro">
    <view class="publish-intro-copy">
      <text class="publish-title">{{goodsId ? '更新闲置' : '发布闲置'}}</text>
      <text class="publish-subtitle">补全信息，通过审核后会展示给同校同学。</text>
    </view>
    <view class="publish-audit-stamp">
      <image class="publish-audit-icon" src="/static/icon-shield-light.svg" mode="aspectFit" aria-hidden="true" />
      <text>审核后展示</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-text">正在加载商品信息...</view>

  <view class="publish-form">
    <view class="publish-card publish-photo-card">
      <view class="publish-card-head">
        <text class="publish-card-title">商品图片</text>
        <text class="publish-photo-count">{{form.photos.length}}/3</text>
      </view>
      <view class="photo-grid {{errors.photos ? 'photo-grid-error' : ''}}">
        <view class="photo-item" wx:for="{{form.photos}}" wx:key="url">
          <image src="{{item.url}}" mode="aspectFill" lazy-load="true" />
          <view class="del-btn" data-index="{{index}}" bindtap="removePhoto">
            <image class="delete-icon" src="/static/icon-close-white.svg" mode="aspectFit" aria-hidden="true" />
          </view>
          <view wx:if="{{index === 0}}" class="cover-label">封面</view>
        </view>
        <view wx:if="{{form.photos.length < 3}}" class="photo-add" bindtap="chooseImages">
          <image class="photo-add-icon" src="/static/icon-upload-photo.svg" mode="aspectFit" aria-hidden="true" />
          <text>添加照片</text>
        </view>
      </view>
      <text class="publish-card-note">首图会作为商品封面，建议上传清晰实拍图。</text>
      <text wx:if="{{errors.photos}}" class="field-error">{{errors.photos}}</text>
    </view>

    <view class="publish-card publish-price-card">
      <view class="publish-price-row">
        <text class="publish-price-label">价格</text>
        <t-input
          class="publish-price-input-component"
          t-class="publish-price-input-shell"
          t-class-label="publish-price-input-a11y-label"
          t-class-input="publish-price-td-input"
          t-class-clearable="publish-price-clearable"
          t-class-tips="publish-price-input-tips"
          label="商品价格"
          type="digit"
          maxlength="9"
          placeholder="0.00"
          value="{{form.price}}"
          borderless="{{true}}"
          clearable="{{true}}"
          clear-trigger="focus"
          status="{{errors.price ? 'error' : 'default'}}"
          tips="{{errors.price}}"
          bind:change="onPriceInput"
          bind:clear="onPriceClear"
        >
          <image slot="prefix-icon" class="publish-price-symbol" src="/static/icon-price-yuan.svg" mode="aspectFit" aria-hidden="true" />
        </t-input>
      </view>
    </view>

    <view class="publish-card">
      <text class="publish-card-title">成色</text>
      <view class="publish-condition-control {{conditionReady ? 'publish-condition-control-ready' : ''}}">
        <view
          class="publish-condition-trigger"
          hover-class="publish-condition-trigger-pressed"
          hover-stay-time="100"
          aria-role="button"
          aria-expanded="{{conditionPickerVisible}}"
          aria-label="商品成色，当前{{form.conditionLevel}}，点击打开滚轮选择"
          bind:tap="openConditionPicker"
        >
          <view class="publish-condition-copy">
            <text class="publish-condition-value" aria-live="polite">{{form.conditionLevel}}</text>
            <text class="publish-condition-hint">{{conditionHint}}</text>
          </view>
          <image
            class="publish-condition-chevron"
            src="/static/icon-chevron-right.svg"
            mode="aspectFit"
            aria-hidden="true"
          />
        </view>
      </view>
      <t-picker
        t-class="publish-condition-picker"
        t-class-confirm="publish-condition-picker-confirm"
        visible="{{conditionPickerVisible}}"
        value="{{conditionPickerValue}}"
        title="选择成色"
        cancel-btn="取消"
        confirm-btn="确定"
        item-height="{{48}}"
        bind:confirm="onConditionPickerConfirm"
        bind:cancel="onConditionPickerCancel"
        bind:visible-change="onConditionPickerVisibleChange"
      >
        <t-picker-item options="{{conditionOptions}}" />
      </t-picker>
    </view>

    <view class="publish-card publish-category-card">
      <text class="publish-card-title">选择商品分类</text>
      <view class="category-picker-grid" aria-role="radiogroup" aria-label="商品分类">
        <t-check-tag
          wx:for="{{categories}}"
          wx:key="id"
          class="publish-category-tag-host"
          t-class="publish-category-tag"
          checked="{{form.categoryId == item.id}}"
          content=""
          variant="light-outline"
          shape="square"
          size="extra-large"
          data-id="{{item.id}}"
          aria-role="radio"
          aria-checked="{{form.categoryId == item.id}}"
          aria-label="{{item.name}}"
          bind:change="chooseCategory"
        >
          <view
            slot="icon"
            class="publish-category-icon-wrap {{form.categoryId == item.id ? 'publish-category-icon-wrap-selected' : ''}}"
          >
            <image
              class="publish-category-icon"
              src="{{item.icon}}"
              mode="aspectFit"
              aria-hidden="true"
            />
          </view>
          <text slot="content" class="publish-category-name">{{item.name}}</text>
        </t-check-tag>
      </view>
      <text wx:if="{{errors.categoryId}}" class="field-error">{{errors.categoryId}}</text>
    </view>

    <view wx:if="{{form.categoryId}}" class="publish-card publish-fields-card">
      <view class="publish-fields">
        <view class="publish-field">
          <view class="publish-field-inline">
            <text class="publish-field-label">标题</text>
            <input class="publish-input" type="text" placeholder="例如：高等数学上册" value="{{form.title}}" maxlength="10" bindinput="onTitleInput" />
            <text class="char-count {{form.title.length >= 10 ? 'char-count-full' : ''}}">{{form.title.length}}/10</text>
          </view>
          <text wx:if="{{errors.title}}" class="field-error">{{errors.title}}</text>
        </view>

        <view class="publish-field">
          <view class="publish-field-inline">
            <text class="publish-field-label">描述</text>
            <textarea class="publish-textarea" placeholder="补全详细交易地点，商品信息等" value="{{form.description}}" maxlength="50" bindinput="onDescriptionInput"></textarea>
            <text class="char-count {{form.description.length >= 50 ? 'char-count-full' : ''}}">{{form.description.length}}/50</text>
          </view>
          <text wx:if="{{errors.description}}" class="field-error">{{errors.description}}</text>
        </view>
      </view>
    </view>

    <view class="publish-card publish-location-card">
      <text class="publish-card-title">交易地点</text>
      <t-segmented
        class="publish-location-segment {{conditionReady ? 'publish-location-segment-ready' : ''}}"
        t-class="publish-location-segment-inner"
        t-class-thumb="publish-location-segment-thumb"
        t-class-item="publish-location-segment-item"
        options="{{locationOptions}}"
        value="{{form.campusLocation}}"
        block="{{true}}"
        aria-role="radiogroup"
        aria-label="交易地点"
        bind:change="chooseLocation"
      />
    </view>

  </view>

  <view class="bottom-bar publish-bottom-bar">
    <view class="publish-submit-copy">
      <text class="publish-submit-title">{{form.categoryId ? '准备好后提交审核' : '请先选择商品分类'}}</text>
      <text class="publish-submit-status {{info ? 'status-text-error' : ''}}">{{info || '审核通过后，其他同学才能看到'}}</text>
    </view>
    <button class="publish-submit-btn" loading="{{submitting}}" disabled="{{submitting || !form.categoryId}}" bindtap="submit">
      {{submitting ? '提交中...' : goodsId ? '保存修改' : '发布闲置'}}
    </button>
  </view>

  <view class="modal-mask" wx:if="{{showContactModal}}" bindtap="closeContactModal"></view>
  <view class="modal-dialog contact-modal" wx:if="{{showContactModal}}">
    <view class="modal-title">补全联系方式</view>
    <view class="modal-body contact-modal-body">
      <text class="modal-text">请先填写联系方式，方便同校同学联系你</text>

      <view class="contact-modal-field">
        <text class="form-label">微信号</text>
        <input class="input-field" type="text" placeholder="可选，填写后商品详情会展示" value="{{contactDraft.wechatId}}" bindinput="onContactWechatInput" />
      </view>

      <view class="contact-modal-field">
        <text class="form-label">QQ号</text>
        <input class="input-field" type="number" maxlength="12" placeholder="可选，5-12位数字" value="{{contactDraft.qq}}" bindinput="onContactQqInput" />
      </view>

      <text wx:if="{{contactError}}" class="field-error">{{contactError}}</text>
      <text wx:else class="field-hint">微信号和 QQ 号至少填写一个</text>
    </view>
    <view class="modal-footer contact-modal-footer">
      <button class="btn btn-ghost contact-modal-cancel" disabled="{{savingContact || submitting}}" bindtap="closeContactModal">取消</button>
      <button class="btn btn-primary contact-modal-save" loading="{{savingContact || submitting}}" disabled="{{savingContact || submitting}}" bindtap="saveContactBeforePublish">
        {{savingContact ? '保存中...' : submitting ? '发布中...' : '保存并发布'}}
      </button>
    </view>
  </view>
</view>

<announcement-popup id="announcementPopup" />
